      "id": "calc-q001",
      "type": "single_choice",
      "prompt": "$f(x) = x^2 \\sin x$ 일 때 $f'(x)$는?",
      "explanation": {
        "summary": "곱의 미분법 $(uv)' = u'v + uv'$ 를 적용한다.",
        "steps": ["$u = x^2,\\; v = \\sin x$ 로 둔다.", "$u' = 2x,\\; v' = \\cos x$", "$$f'(x) = 2x\\sin x + x^2\\cos x$$"],
        "misconceptions": ["$\\sin x$ 의 도함수를 $-\\cos x$ 로 혼동하는 경우가 많다."]
      },
      "difficulty": 2,
      "tags": ["미분"],
      "hint": "곱의 미분법: $(uv)' = u'v + uv'$",
      "choices": [
        { "id": "a", "text": "$2x\\sin x + x^2\\cos x$", "explanation": "곱의 미분법을 정확히 적용한 결과" },
        { "id": "b", "text": "$2x\\cos x$", "explanation": "$x^2$ 만 미분하고 $\\sin x$ 를 상수처럼 취급한 오답" },
        { "id": "c", "text": "$x^2\\cos x$", "explanation": "$u'v$ 항이 빠졌다" },
        { "id": "d", "text": "$2x\\sin x - x^2\\cos x$", "explanation": "부호 오류" }
      ],
      "answer": { "choiceId": "a" }
    },
    {
