      },
      "difficulty": 2,
      "tags": ["Python"],
      "language": "python",
      "code": "squares = [x {{op}} 2 for x in {{fn}}(10) if x % 2 == {{rem}}]\nprint(squares)  # [0, 4, 16, 36, 64]",
