// Recall Studio — Prisma schema (MySQL 8 / TiDB)
// Conventions: every entity carries createdAt / updatedAt / deletedAt (soft delete; null = live).
// Multi-tenant: EVERY entity carries `userId` (denormalised onto children too) so each query is scoped
// with a single `where: { userId }`; `PrismaService` throws when a tenant model is queried without it.
// FSRS card state is stored both as explicit columns (for queries/indexes) and as the full
// ts-fsrs Card JSON (`stateJson`) so library state round-trips losslessly.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  short_answer
  essay
  cloze
  ordering
  matching
  // extended types (additive)
  numeric
  cloze_select
  statement_set
  categorize
  two_tier
  recall_card
  stepwise
  highlight
  // extended set 2 (additive)
  cloze_bank
  code_cloze
  matrix
  numeric_grid
  list_answer
  image_hotspot
  parsons
  find_and_fix
  coordinate_point
  regex_answer
}

enum CardStatus {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum SessionMode {
  study
  cram
  practice
  exam
}

enum ShareKind {
  deck
  subject
  questions
}

// `expired` is never stored: a pending share past `expiresAt` is reported as expired.
enum ShareStatus {
  pending
  accepted
  declined
  canceled
}

// A signed-in person. `provider` + `providerSub` identify the identity (google sub, or "dev" email locally).
model User {
  id          String    @id @default(cuid())
  provider    String    @db.VarChar(16)
  providerSub String    @db.VarChar(191)
  email       String    @db.VarChar(320)
  name        String?   @db.VarChar(200)
  image       String?   @db.VarChar(2048)
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  decks            Deck[]
  questions        Question[]
  subjects         Subject[]
  questionSubjects QuestionSubject[]
  cards            CardState[]
  reviews          ReviewLog[]
  notes            QuestionNote[]
  sessions         StudySession[]
  practices        PracticeLog[]
  examAttempts     ExamAttempt[]
  examResponses    ExamResponse[]
  settings         AppSettings?
  sharesSent       Share[]           @relation("SharesSent")
  sharesAccepted   Share[]           @relation("SharesAccepted")

  @@unique([provider, providerSub])
  @@index([email])
  @@index([deletedAt])
}

model Deck {
  id          String    @id @default(cuid())
  userId      String
  slug        String    @db.VarChar(80) // external stable id from batch.deck.id (unique per user)
  title       String    @db.VarChar(200)
  description String?   @db.Text
  subject     String    @db.VarChar(200)
  language    String    @db.VarChar(35)
  tagsJson    Json
  originId    String?   @db.VarChar(64) // root deck id this deck was copied from through a share (null = authored here)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions    Question[]
  sessions     StudySession[]
  examAttempts ExamAttempt[]

  @@unique([userId, slug])
  @@index([userId, subject])
  @@index([userId, originId])
  @@index([userId, archivedAt])
  @@index([deletedAt])
}

model Question {
  id          String       @id @default(cuid())
  userId      String
  externalId  String       @db.VarChar(80)
  deckId      String
  type        QuestionType
  payloadJson Json
  contentHash String       @db.Char(64)
  answerHash  String       @db.Char(64)
  revision    Int          @default(1)
  sortIndex   Int          @default(0)
  originId    String?      @db.VarChar(64) // root question id this was copied from through a share (matches re-shared copies on merge)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime? // soft delete (also set by replace_deck imports)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck          Deck              @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card          CardState?
  reviews       ReviewLog[]
  notes         QuestionNote[]
  examResponses ExamResponse[]
  practiceLogs  PracticeLog[]
  subjects      QuestionSubject[]

  @@unique([deckId, externalId])
  @@index([userId])
  @@index([deckId, type])
  @@index([deckId, sortIndex])
  @@index([deletedAt])
}

// Subjects are tag-like labels: one question can belong to many subjects.
// The deck's `subject` is assigned automatically on import (source = "deck"); learners add more (source = "manual").
model Subject {
  id          String    @id @default(cuid())
  userId      String
  name        String    @db.VarChar(200)
  color       String?   @db.VarChar(16)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuestionSubject[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
  @@index([deletedAt])
}

model QuestionSubject {
  questionId String
  subjectId  String
  userId     String
  source     String    @default("manual") @db.VarChar(16) // deck | manual
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([questionId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

model CardState {
  questionId   String     @id
  userId       String
  stateJson    Json // full ts-fsrs Card (dates as ISO strings)
  dueAt        DateTime
  status       CardStatus @default(NEW)
  stability    Float      @default(0)
  difficulty   Float      @default(0)
  reps         Int        @default(0)
  lapses       Int        @default(0)
  lastReviewAt DateTime?
  suspended    Boolean    @default(false) // excluded from study queues until resumed
  flagged      Boolean    @default(false) // learner bookmark
  buriedUntil  DateTime? // hidden from queues until this instant
  version      Int        @default(0) // optimistic concurrency
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt, status])
  @@index([userId, status])
  @@index([userId, flagged])
}

model ReviewLog {
  id                     String     @id @default(cuid())
  userId                 String
  questionId             String
  sessionId              String?
  idempotencyKey         String     @db.VarChar(120)
  rating                 Int // 1 Again, 2 Hard, 3 Good, 4 Easy
  previousStatus         CardStatus @default(NEW)
  reviewRound            Int // nth effective review of this question (1-based)
  reviewedAt             DateTime   @default(now())
  elapsedMs              Int        @default(0)
  isCorrect              Boolean?
  revealedBeforeAnswer   Boolean    @default(false)
  hintUsed               Boolean    @default(false)
  answerPayloadJson      Json?
  previousCardStateJson  Json
  resultingCardStateJson Json
  fsrsLogJson            Json
  schedulerVersion       String     @db.VarChar(40)
  undone                 Boolean    @default(false)
  undoneAt               DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session  StudySession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  notes    QuestionNote[]

  @@unique([userId, idempotencyKey])
  @@index([questionId, reviewedAt])
  @@index([userId, reviewedAt])
  @@index([sessionId])
}

model QuestionNote {
  id          String    @id @default(cuid())
  userId      String
  questionId  String
  reviewRound Int // one note per review round per question
  reviewLogId String?
  body        String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewLog ReviewLog? @relation(fields: [reviewLogId], references: [id], onDelete: SetNull)

  @@unique([questionId, reviewRound])
  @@index([userId])
  @@index([questionId, updatedAt])
}

model StudySession {
  id        String      @id @default(cuid())
  userId    String
  deckId    String? // null for cross-deck sessions
  scope     String      @default("deck") @db.VarChar(120) // deck | all | subject:<name>
  mode      SessionMode @default(study)
  startedAt DateTime    @default(now())
  endedAt   DateTime?
  queueSize Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      Deck?         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews   ReviewLog[]
  practices PracticeLog[]

  @@index([deckId, startedAt])
  @@index([userId, startedAt])
}

model PracticeLog {
  id                String    @id @default(cuid())
  userId            String
  questionId        String
  sessionId         String?
  isCorrect         Boolean?
  answerPayloadJson Json?
  elapsedMs         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session  StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([questionId, createdAt])
  @@index([userId, createdAt])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  deckId      String
  title       String    @default("") @db.VarChar(200)
  configJson  Json
  questionIds Json // ordered internal question ids
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  scoreJson   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  responses ExamResponse[]

  @@index([deckId, startedAt])
  @@index([userId, startedAt])
}

model ExamResponse {
  id                String    @id @default(cuid())
  userId            String
  attemptId         String
  questionId        String
  answerPayloadJson Json?
  isCorrect         Boolean?
  gradeDetailJson   Json?
  selfScore         Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([userId])
}

// A deck / subject / question selection sent to another person by e-mail. The content is frozen into
// `snapshotJson` at send time; accepting copies it into the recipient's account (fresh learning state).
// Owned by the sender (`userId`); the recipient side is scoped by `recipientEmail` (see tenant-guard.ts).
model Share {
  id             String      @id @default(cuid())
  userId         String // sender
  recipientEmail String      @db.VarChar(320) // lower-cased
  recipientId    String? // the user who accepted or declined
  kind           ShareKind
  title          String      @db.VarChar(200)
  message        String?     @db.Text
  snapshotJson   Json
  deckCount      Int
  questionCount  Int
  status         ShareStatus @default(pending)
  expiresAt      DateTime
  respondedAt    DateTime?
  resultJson     Json? // what accepting created: { decks: [{ id, title, created, updated, skipped }] }
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  user      User  @relation("SharesSent", fields: [userId], references: [id], onDelete: Cascade)
  recipient User? @relation("SharesAccepted", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([recipientEmail, status])
  @@index([recipientId])
}

// One row per user (created lazily on first read).
model AppSettings {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  newCardsPerDay         Int       @default(20)
  reviewsPerDay          Int       @default(200)
  timezone               String    @default("Asia/Seoul") @db.VarChar(64)
  shortcutsEnabled       Boolean   @default(true)
  showIntervalPreview    Boolean   @default(true)
  autoAdvanceAfterRating Boolean   @default(true)
  requestRetention       Float     @default(0.9)
  maximumInterval        Int       @default(36500)
  enableFuzz             Boolean   @default(false)
  shuffleChoices         Boolean   @default(true)
  /// Study screen: hide question metadata that could hint at the answer (each item toggles independently).
  hideDifficulty         Boolean   @default(false)
  hideTags               Boolean   @default(false)
  hideSubject            Boolean   @default(false)
  hideSource             Boolean   @default(false)
  hideRound              Boolean   @default(false)
  /// Show every hidden item once the answer is revealed (until the next card); the hide flags stay as they are.
  revealMetaOnAnswer     Boolean   @default(false)
  /// How an essay's model answer is shown after submitting: plain (the text) | scored (segments with their points; falls back to plain when the question has no segments).
  essayAnswerView        String    @default("plain") @db.VarChar(16)
  newCardOrder           String    @default("deck") @db.VarChar(16) // deck | random
  dailyReviewGoal        Int       @default(50)
  leechThreshold         Int       @default(8)
  /// Defaults for the LLM question-generator prompt CONFIG block (partial; keys from docs/QUESTION_GENERATOR_PROMPT.md). null = prompt's own values.
  promptDefaults         Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
