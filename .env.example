# Copy to apps/api/.env and apps/web/.env.local (values below are LOCAL DEV defaults; see docs/DEPLOYMENT.md for production).

# --- API (apps/api/.env) ---
DATABASE_URL="mysql://recall:recall@127.0.0.1:3306/recall_studio"
TEST_DATABASE_URL="mysql://root:recall@127.0.0.1:3306/recall_studio_test"
API_PORT=4000
API_HOST=127.0.0.1
# Browser origins allowed by CORS (comma-separated). Localhost is always allowed outside production.
WEB_ORIGIN=http://localhost:3000
# Shared with the web app: the web mints API bearer tokens with it, the API verifies them. ≥32 chars in production.
API_JWT_SECRET=dev-only-api-jwt-secret-change-me-0123456789

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
API_JWT_SECRET=dev-only-api-jwt-secret-change-me-0123456789
# Auth.js session cookie encryption key (`openssl rand -base64 32`)
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials). Leave empty locally to use the dev login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Password-less "dev login" (any e-mail). Local development and e2e only — never set in production.
AUTH_DEV_LOGIN=1
