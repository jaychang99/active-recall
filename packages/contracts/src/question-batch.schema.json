{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recall-studio.local/schemas/question-batch.schema.json",
  "title": "Recall Studio Question Batch",
  "description": "Portable AI-generated deck/question import contract. Syntactic validation plus application semantic invariants. Version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deck",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subject",
        "language",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "description": "BCP-47 language tag, e.g. ko or en"
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/single_choice"
          },
          {
            "$ref": "#/$defs/multiple_choice"
          },
          {
            "$ref": "#/$defs/true_false"
          },
          {
            "$ref": "#/$defs/short_answer"
          },
          {
            "$ref": "#/$defs/essay"
          },
          {
            "$ref": "#/$defs/cloze"
          },
          {
            "$ref": "#/$defs/ordering"
          },
          {
            "$ref": "#/$defs/matching"
          }
        ]
      }
    }
  },
  "$defs": {
    "single_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt",
        "explanation",
        "difficulty",
        "tags",
        "choices",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "steps": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "misconceptions": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "references": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document"
                ],
                "properties": {
                  "document": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "estimatedSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document"
          ],
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "location": {
              "type": "string",
              "maxLength": 300
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "type": {
          "const": "single_choice"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "explanation": {
                "type": "string",
                "maxLength": 3000
              }
            }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choiceId"
          ],
          "properties": {
            "choiceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            }
          }
        }
      }
    },
